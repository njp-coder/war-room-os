# Copy to .env and fill in. .env is read at startup; never commit it.

# LLM (HiDevs gateway, OpenAI-compatible). Without it agents still run, on their scripted policy.
HIDEVS_API_KEY=

# Moss vector memory (hackathon requirement). Without it memory falls back to a local index, labelled in the UI.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Optional. If empty, War Room uses your `gh auth login` session.
GITHUB_TOKEN=

# Sign-in: a GitHub OAuth App (github.com/settings/developers > OAuth Apps > New).
# Homepage URL = WARROOM_PUBLIC_URL; Authorization callback URL = WARROOM_PUBLIC_URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WARROOM_PUBLIC_URL=http://localhost:3217
# 1 brings back the "pick a person" sign-in for demos. Anyone can act as anyone while it's on.
WARROOM_DEMO_MODE=
